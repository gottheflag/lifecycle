{
	"name": "@gottheflag/lifecycle",
	"version": "0.1.0",
	"description": "Lifetime, event, and resource management.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=18.18.0"
	},
	"scripts": {
		"build": "tsup && pnpm build:types",
		"build:types": "tsc --emitDeclarationOnly --declaration --declarationMap && tsc --emitDeclarationOnly --declaration --declarationMap --outDir ./dist/cjs && node ./scripts/write-cjs-package.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"playground": "vite --config ./playground/vite.config.ts",
		"typecheck": "pnpm typecheck:src && pnpm typecheck:tests && pnpm typecheck:playground",
		"typecheck:src": "tsc --noEmit",
		"typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
		"typecheck:playground": "tsc --noEmit -p tsconfig.playground.json",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix --max-warnings=0",
		"check:package": "pnpm build && node ./scripts/check-package.mjs",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:package",
		"prepack": "pnpm build"
	},
	"keywords": [
		"lifecycle",
		"event",
		"cleanup",
		"resource",
		"ownership"
	],
	"author": {
		"name": "GTF",
		"url": "https://gottheflag.sa",
		"email": "dev@gottheflag.sa"
	},
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/gottheflag/lifecycle"
	},
	"bugs": {
		"url": "https://github.com/gottheflag/lifecycle/issues"
	},
	"homepage": "https://github.com/gottheflag/lifecycle#readme",
	"packageManager": "pnpm@11.0.9",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.1",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.7"
	}
}
